# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=development
APP_NAME=SmartphoneCases
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ============================================
# DATABASE SETTINGS (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartphonecases
DB_USER=admin
DB_PASSWORD=password123

# ============================================
# REDIS SETTINGS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# JWT SETTINGS
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ============================================
# STRIPE PAYMENT SETTINGS
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# MERCADO PAGO SETTINGS
# ============================================
MP_ACCESS_TOKEN=TEST-YOUR-MERCADO-PAGO-ACCESS-TOKEN

# ============================================
# EMAIL SETTINGS (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@smartphonecases.com

# ============================================
# FILE UPLOAD SETTINGS
# ============================================
MAX_FILE_SIZE=5242880 # 5MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# SECURITY
# ============================================
SESSION_SECRET=your-session-secret-key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_TO_FILE=true

# ============================================
# ADMIN SETTINGS
# ============================================
ADMIN_EMAIL=admin@smartphonecases.com
ADMIN_INITIAL_PASSWORD=ChangeThis123!